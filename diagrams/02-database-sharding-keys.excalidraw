      "boundElements": [],
      "updated": 1711800000000,
      "link": null,
      "locked": false,
      "text": "LSM-Tree (Cassandra / ScyllaDB / DynamoDB)\n\u2022 Appends to sequential WAL + RAM MemTable (lock-free)\n\u2022 Flushes immutable SSTables; Bloom filter skips misses\n\u2022 Absorbs 50k\u2013100k+ writes/sec per node\n\u2022 Best for: Chat messages, Notification logs, Events",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "LSM-Tree (Cassandra / ScyllaDB / DynamoDB)\n\u2022 Appends to sequential WAL + RAM MemTable (lock-free)\n\u2022 Flushes immutable SSTables; Bloom filter skips misses\n\u2022 Absorbs 50k\u2013100k+ writes/sec per node\n\u2022 Best for: Chat messages, Notification logs, Events",
      "lineHeight": 1.25,
      "autoResize": true
    }
