      "boundElements": [],
      "updated": 1711800000000,
      "link": null,
      "locked": false,
      "text": "B-Tree (PostgreSQL / MySQL InnoDB)\n\u2022 Updates 16 KB pages in place + WAL\n\u2022 Fast predictable reads (1 canonical tree)\n\u2022 Row/page locks cap writes at ~5k\u201310k/s per primary\n\u2022 Best for: Users, Billing, ACID inventory",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "B-Tree (PostgreSQL / MySQL InnoDB)\n\u2022 Updates 16 KB pages in place + WAL\n\u2022 Fast predictable reads (1 canonical tree)\n\u2022 Row/page locks cap writes at ~5k\u201310k/s per primary\n\u2022 Best for: Users, Billing, ACID inventory",
      "lineHeight": 1.25,
      "autoResize": true
    },
